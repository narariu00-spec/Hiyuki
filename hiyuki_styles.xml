<?xml version="1.0" encoding="utf-8"?>
<!-- Hiyuki Theme Style Configuration -->
<resources>
    <!-- Typography -->
    <style name="HiyukiTextStyle.Title">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="HiyukiTextStyle.Subtitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#B3B3B3</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="HiyukiTextStyle.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <style name="HiyukiTextStyle.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#808080</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    
    <!-- Button Styles -->
    <style name="HiyukiButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:padding">12dp</item>
    </style>
    
    <!-- Card Styles -->
    <style name="HiyukiCard">
        <item name="android:background">#1E2936</item>
        <item name="android:elevation">4dp</item>
    </style>
    
    <!-- Dialog Styles -->
    <style name="HiyukiDialog">
        <item name="android:background">#1A1F26</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
</resources>